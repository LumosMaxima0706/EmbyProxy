[Unit]
Description=EmbyProxy isolated BWG controller to NOSLA test tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -i /var/lib/embyproxy-vps-control-plane-test/ssh/nosla-test-tunnel_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/embyproxy-publication-agent/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:28180:127.0.0.1:18181 -R 127.0.0.1:28180:127.0.0.1:18180 embyproxy-meter@45.143.130.11
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/embyproxy-vps-control-plane-test

[Install]
WantedBy=multi-user.target
