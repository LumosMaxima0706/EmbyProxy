[Unit]
Description=EmbyProxy isolated BWG controller to NOSLA test tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -i /etc/embyproxy-publication-agent/nosla_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/embyproxy-publication-agent/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:28180:127.0.0.1:18181 -R 127.0.0.1:28180:127.0.0.1:18180 root@45.143.130.11
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/embyproxy-vps-control-plane-test

[Install]
WantedBy=multi-user.target
