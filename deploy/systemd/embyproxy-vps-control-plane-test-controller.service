[Unit]
Description=EmbyProxy VPS control-plane isolated test controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/var/lib/embyproxy-vps-control-plane-test/controller.env
WorkingDirectory=/opt/embyproxy-vps-control-plane-test/integration
ExecStart=/opt/embyproxy-vps-control-plane-test/bin/embyproxy-controller
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/embyproxy-vps-control-plane-test /var/log/embyproxy-vps-control-plane-test /opt/embyproxy-vps-control-plane-test

[Install]
WantedBy=multi-user.target
