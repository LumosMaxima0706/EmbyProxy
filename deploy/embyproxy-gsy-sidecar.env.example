# ADMIN_TOKEN is required and must be generated on the deployment target.
# Never commit or print its value.
LISTEN_ADDR=127.0.0.1:18082
DB_PATH=/var/lib/embyproxy-gsy-sidecar/proxy.db
MEDIAPROXY_ROUTES_ENABLED=true
PUBLIC_MEDIA_BASE_URL=https://media.example
PUBLIC_MEDIA_NODE_PATHS_JSON='{"example":"/public/example"}'
FAILOVER_DNS_REAL_APPLY_ENABLED=false
FAILOVER_MOCK_FIXTURE_ENABLED=false
TZ=Asia/Shanghai
