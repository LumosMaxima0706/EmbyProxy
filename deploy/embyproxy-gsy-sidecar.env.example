# ADMIN_TOKEN is required and must be generated on the deployment target.
# Never commit or print its value.
LISTEN_ADDR=127.0.0.1:18082
DB_PATH=/var/lib/embyproxy-gsy-sidecar/proxy.db
MEDIAPROXY_ROUTES_ENABLED=true
PUBLICATION_AGENT_SOCKET=/run/embyproxy-publication-agent/agent.sock
# HTTPS controller origin embedded in short-lived edge enrollment commands.
# It must be the externally reachable controller origin, not an admin secret.
ENROLLMENT_CONTROLLER_URL=https://owner-admin.example
# Per-slug playback credentials live outside SQLite and must be provisioned
# only on the deployment host. The sidecar creates this directory as 0700.
PLAYBACK_CREDENTIAL_DIR=/var/lib/embyproxy-gsy-sidecar/playback-credentials
PUBLIC_MEDIA_BASE_URL=https://media.example
PUBLIC_MEDIA_NODE_PATHS_JSON='{"example":"/public/example"}'
FAILOVER_DNS_REAL_APPLY_ENABLED=false
FAILOVER_MOCK_FIXTURE_ENABLED=false
TZ=Asia/Shanghai
