# 管理员 Token（必填，用于 API 访问和管理界面登录）
ADMIN_TOKEN=change-me-please
OWNER_ADMIN_AUTH_MODE=
OWNER_ADMIN_HOST=

# Public node links shown by Admin. The base must be an HTTPS origin; paths are
# a JSON object keyed by node name and must not contain credentials or queries.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_NODE_PATHS_JSON={}

# 紧急恢复：临时设为 true 并重启，重新绑定或关闭 2FA 后改回 false 并再次重启
# 启用 2FA 后若更改了 ADMIN_TOKEN，需要重新设置 2FA
# ADMIN_2FA_DISABLED=false

# Phase 2C mediaproxy production routes (default disabled)
# MEDIAPROXY_ROUTES_ENABLED=false

# 监听端口
# PORT=8787

# 可选：显式代理监听地址，优先于 HOST + PORT。未设置时保持 0.0.0.0:PORT。
# LISTEN_ADDR=127.0.0.1:19080
# HOST=127.0.0.1

# 可选：独立管理监听地址。设置后 /admin 和 /api/admin 仅由该监听器提供。
# ADMIN_LISTEN_ADDR=127.0.0.1:19081
# 也可使用 ADMIN_HOST + ADMIN_PORT；DYNDNS_PORT 是 ADMIN_PORT 的兼容回退。
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=19081

# Failover DNS apply 默认关闭。mock staging 必须同时显式选择 mode 和 allowlist。
# FAILOVER_DNS_PROVIDER_MODE=mock
# FAILOVER_DNS_ALLOWED_RECORDS=stream.mock.invalid:A
# Isolated regression only: injects in-memory mock nodes; never enable with real/external mode.
# FAILOVER_MOCK_FIXTURE_ENABLED=false
# 真实 provider 在 rollback metadata 能力完成前仍会 fail-closed。
# FAILOVER_DNS_REAL_APPLY_ENABLED=false

# SQLite 数据库路径
# DB_PATH=./data/proxy.db

# 系统显示时区（不设置时默认正八区）
# TZ=Asia/Shanghai
